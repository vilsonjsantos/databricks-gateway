# Lista completa e explicada em docs/CONFIGURACAO.md (seção 2). O .env real NUNCA vai para o repositório.
# ---------- LLM / agente (API compatível com OpenAI) ----------
# Teste em casa: DeepSeek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY_FILE=
# Empresa: Databricks Model Serving
# LLM_BASE_URL=https://<workspace-host>/serving-endpoints
# LLM_API_KEY=            # só em AUTH_MODE=static; em browser o TokenManager injeta o token
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=300
AGENT_API=chat                    # chat | responses
AGENT_PAYLOAD_MODE=json-content   # json-content | custom-inputs

# ---------- Gateway ----------
TOKEN_SECRET=<aleatório, >=32 bytes; igual ao GATEWAY_TOKEN_SECRET do Apps Script>
ADMIN_KEY=<aleatório >=16; vazio desliga /admin; NUNCA em URL>
PANEL_KEY=<aleatório >=16, DIFERENTE da ADMIN_KEY; só-leitura do painel executivo; é a da URL ?k= da tela fixa>
# EXPOSE_DOCS=false               # /docs e /openapi.json (deixe false)
# ADMIN_MAX_FAILURES=10           # falhas de chave por cliente em 5 min antes de bloquear (429)
APPS_DIR=apps
# CORS_ORIGIN_REGEX=^https://[a-z0-9-]+-script\.googleusercontent\.com$
# CORS_ORIGINS=https://outro-front.empresa.local
EVENTS_BUFFER=500

# ---------- Robustez ----------
# TOKEN_SECRET_PREVIOUS=          # só durante a rotação do segredo
# MAX_BODY_BYTES=65536
# MAX_CONCURRENCY=32
# REQUEST_CACHE_TTL_S=120
# ERROR_ALERT_RATE=0.3
# ERROR_ALERT_MIN_CALLS=10
# (no endpoint do agente, não aqui) CONVERSATION_STORE=delta  CONVERSATION_TABLE=<cat>.<schema>.conversas

# ---------- Painel executivo / histórico ----------
HISTORY_DB=data/history.sqlite    # :memory: = não guarda histórico
PANEL_TITLE=Assistente de Atendimento
PANEL_LOCALHOST_NO_KEY=false      # true só SEM proxy reverso

# ---------- Autenticação no Databricks (produção) ----------
AUTH_MODE=static                  # static | browser
# DATABRICKS_HOST=https://<workspace>
# BROWSER_PROFILE_DIR=browser-profile
# BROWSER_CHANNEL=msedge          # msedge | chrome | chromium
# BROWSER_HEADLESS=true
# BROWSER_LOGIN_TIMEOUT_S=120
# TOKEN_REFRESH_MARGIN_S=300
# AUTH_BACKOFF_S=30
# AUTH_BACKOFF_MAX_S=900

# ---------- Resiliência / alertas ----------
# BREAKER_FAILURES=5
# BREAKER_RESET_S=30
# ALERT_WEBHOOK_URL=
# ALERT_MIN_INTERVAL_S=900

# HTTPS direto no uvicorn: definir como variáveis de SISTEMA (lidas por deploy\run-gateway.ps1)
# GATEWAY_SSL_CERT=C:\certs\gateway.crt
# GATEWAY_SSL_KEY=C:\certs\gateway.key
